# API URLs (AUTH_BASE_URL is server-only; NEXT_PUBLIC_AUTH_BASE_URL is browser-visible)
AUTH_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_AUTH_BASE_URL=http://localhost:8000/api/v1

# NextAuth (use a unique random value of at least 32 characters)
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
